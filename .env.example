# Copy this file to .env.local for local development.
# Set these same variables in your Vercel project settings for production.
# NEVER commit a .env file with real values.

# Powers analyze-jd, fetch-linkedin, search-linkedin, and research-person.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Powers the Freelance Pitch tab (generate-pitch). Free key (no card) from console.groq.com.
GROQ_API_KEY=your_groq_api_key_here
HUNTER_API_KEY=your_hunter_api_key_here
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=2f312b17-d357-8155-b06f-000b29a1c83f

# Optional: lock down CORS in production to your Vercel URL
# ALLOWED_ORIGIN=https://your-app.vercel.app
